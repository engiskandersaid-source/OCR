OPENAI_API_KEY=sk-...your-new-key...
OPENAI_MODEL=gpt-4o-mini
OCR_SERVICE_URL=http://127.0.0.1:8001

# Chat assistant: answers only from the stored transfers (uses the same OPENAI_API_KEY).
OPENAI_CHAT_MODEL=gpt-4o

# The exact address people type in their browser. Requests from any other origin are refused.
# On the local network, use the HTTPS address served by Caddy, e.g. https://virementocr.lan
APP_ORIGIN=http://localhost:3000

# Shared secret between this app and the OCR service. The OCR service reads it from this file.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
OCR_SERVICE_TOKEN=change-me
